{
  "name": "quiver",
  "productName": "Quiver",
  "version": "0.1.0",
  "description": "Quiver - a local-first Chromium browser for developers on Windows. Vertical sidebar, Spaces, developer command bar, environment switching, phone preview and Boosts.",
  "main": "dist/main/main.js",
  "license": "MIT",
  "author": "Sean Shaffer",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "build:win": "npm run build && electron-builder --win nsis portable --x64",
    "build:msi": "npm run build && electron-builder --win msi --x64",
    "build:dir": "npm run build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.quiver.browser",
    "productName": "Quiver",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/tests/**",
      "!dist/main/mcp.js",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Quiver-v${version}-x64-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Quiver-v${version}-x64-Portable.${ext}"
    },
    "msi": {
      "artifactName": "Quiver-v${version}-x64-Setup.${ext}"
    }
  }
}
